# Reemplaza por una clave larga y unica
APP_JWT_SECRET=mi-secreto-super-largo

# Duracion del token en dias
APP_TOKEN_DAYS=0.5

# Usuarios iniciales del sistema (JSON en una linea)
# Roles disponibles: admin, editor, viewer
APP_USERS_JSON=[{"username":"Jiovanny","password":"M3g@JMdev","displayName":"Tu","role":"admin"},{"username":"Ibeth","password":"IbeJio2026","displayName":"Ibeth","role":"editor"}]

# Netlify Blobs (necesario si el contexto automatico de Blobs no esta habilitado)
NETLIFY_SITE_ID=REEMPLAZA_CON_EL_SITE_ID_DE_NETLIFY
NETLIFY_AUTH_TOKEN=REEMPLAZA_CON_UN_TOKEN_PRIVADO_DE_NETLIFY

# Configuracion opcional para el build estatico que abras con Live Server
# Debe empezar con VITE_ para quedar disponible en el frontend
VITE_FORCE_LOCAL_API=false
VITE_ENABLE_LOCAL_FALLBACK=false
VITE_LOCAL_USERS_JSON=[{"username":"Jiovanny","password":"M3g@JMdev","displayName":"Tu","role":"admin"},{"username":"Ibeth","password":"IbeJio2026","displayName":"Ibeth","role":"editor"}]
